APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=UTC

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mytodo
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
# Optional private JSON key file, kept outside public/ and Git.
# When PUBLIC/PRIVATE above are both empty, storage/private/vapid.json is used.
# VAPID_KEYS_FILE=I:/private/mytodo-vapid.json

# Bounded reminder workers launched by the once-per-minute CLI job.
REMINDER_WORKERS=4
REMINDER_RUNTIME_SECONDS=45

# Local Vite HTTPS development server
# Optional PHP CLI executable for npm run dev; defaults to php from PATH.
# MYTODO_PHP_BINARY=C:/xampp/php/php.exe
MYTODO_VITE_CERT_PATH=C:/path/to/mytodo.php.crt
MYTODO_VITE_KEY_PATH=C:/path/to/mytodo.php.key
