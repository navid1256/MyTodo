{
    "name": "navid/7todo",
    "description": "A simple Todolist (with ajax,php and mysql)",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Navid",
            "email": "navid.syndicate@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "hekmatinasser/verta": "^2.1",
        "minishlink/web-push": "^11.0",
        "nyholm/psr7": "^1.8",
        "symfony/http-client": "^7.4",
        "symfony/http-foundation": "^6.4",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
