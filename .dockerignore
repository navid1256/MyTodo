# Start with an allowlist so credentials and unrelated files never enter the build context.
**
!Dockerfile
!.dockerignore
!composer.json
!composer.lock
!package.json
!package-lock.json
!vite.config.js
!App/
!App/**
!config/
!config/**
!docker/
!docker/**
!process/
!process/**
!public/
!public/**
!resources/
!resources/**
!routes/
!routes/**
!views/
!views/**

# Never copy generated assets, user uploads, local configuration, or private keys.
public/build/
public/storage/
**/.env
**/.env.*
**/.git
**/node_modules
/vendor/
**/*.pem
**/*.key
**/*.crt
**/*.pfx
**/*.sql
**/*.log
**/*vapid*.json
**/auth.json
**/AGENTS.md
